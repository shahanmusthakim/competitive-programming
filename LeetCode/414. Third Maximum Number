class Solution {
public:
    int thirdMax(vector<int>& nums) {
        int n = nums.size();
        set<int, greater<int>> s;
        for (int i = 0; i < n; i++) {
            s.insert(nums[i]);
        }
        if (s.size() < 3)
            return *s.begin();
        int ans = 0, a = 1;

        for (int x : s) {
            if (a == 3)
                ans = x;
            a++;
        }
        return ans;
    }
};
