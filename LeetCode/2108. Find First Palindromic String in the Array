class Solution {
public:
    bool check(string S){
        string T=S;
        reverse(T.begin(),T.end());
        if(T==S)return true;
        else return false;
    }
    string firstPalindrome(vector<string>& words) {
        for(int i=0;i<words.size();i++){
            if(check(words[i])){
                return words[i];
            }
        }
        return "";
    }
};
