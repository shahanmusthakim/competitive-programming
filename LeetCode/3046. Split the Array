class Solution {
public:
    bool isPossibleToSplit(vector<int>& nums) {
        vector<int> v;
        unordered_set<int> s;
        int n = nums.size();
        for (int i = 0; i < n; i++) {
            if (s.find(nums[i]) == s.end())
                s.insert(nums[i]);
            else
                v.push_back(nums[i]);
        }
        sort(v.begin(), v.end());
        for (int i = 1; i < (int)v.size(); i++) {
            if (v[i] == v[i - 1])
                return false;
        }
        return true;
    }
};
