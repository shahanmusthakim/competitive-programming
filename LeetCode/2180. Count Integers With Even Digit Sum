class Solution {
public:
    int check(int n){
        int tmp=0;
        while(n!=0){
            int x=n%10;
            tmp+=x;
            n/=10;
        }
        return tmp;
    }
    int countEven(int num) {
        int ans=0;
        for(int i=1;i<=num;i++){
            if(check(i)%2==0)ans++;
        }
        return ans;
    }
    
};
