class Solution {
public:
   bool is_sorted(vector<int>v){
        int N=v.size();
        for(int i=0;i<N-1;i++){
            if (v[i]>v[i+1])
             return false;
        }
        return true;
    }
    bool check(vector<int>& nums) {
        int sz=nums.size();
        if(is_sorted(nums)){
            return true;
        }
        vector<int>tmp,ans;
        int i=0;
        while(nums[i]<=nums[i+1]){
            tmp.push_back(nums[i]);
            i++; 
        }
        tmp.push_back(nums[i]);
        for(int j=i+1;j<sz;j++){
            ans.push_back(nums[j]);
        }

        for(int j=0;j<tmp.size();j++){
            ans.push_back(tmp[j]);
        }

        if(is_sorted(ans))
           return true;
        else 
           return false;   

    }
};
