class Solution {
public:
    bool areNumbersAscending(string s) {
        stringstream ss(s);
        string word;
        int pre = 0;
        while (ss >> word) {
            if (isdigit(word[0])) {
                int x=stoi(word);
                if (x<=pre)
                    return false;

                pre=x;
            }
        }
        return true;
    }
};
