class Solution {
public:
    bool checkRecord(string s) {
       int cnt_A=0;
       bool late=false;
       for(int i=0;i<s.size();i++){
         if(s[i]=='A')cnt_A++;
         if(i!=0 && i!=(s.size()-1) && s[i]=='L'){
          if(s[i-1]=='L' && s[i+1]=='L')late=true;
         }

       }
       if(!late && cnt_A<2)return true;
       else return false; 
    }
};
