class Solution {
public:
    int lengthOfLongestSubstring(string s) {
     map<char,int>m;
     int n=s.size(),i=0,j=0,ans=0;
     while(j<n){
        m[s[j]]++;
        if(m[s[j]]>1){
            while(m[s[j]]>1){
                m[s[i]]--;
                if(m[s[i]]==0)m.erase(s[i]);
                i++;

            }
        }
        ans=max(ans,(j-i)+1);
        j++;
     }
     return ans;
    }
};
