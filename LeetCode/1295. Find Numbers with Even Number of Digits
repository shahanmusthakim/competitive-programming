class Solution {
    bool is_even(int N){
        string S=to_string(N);
        if(S.size()%2==0)return true;
        else return false;
    }
public:
    int findNumbers(vector<int>& nums) {
        int n=nums.size(),ans=0;
        for(int i=0;i<n;i++){
            if(is_even(nums[i]))ans++;
        }
        return ans;
    }
};
