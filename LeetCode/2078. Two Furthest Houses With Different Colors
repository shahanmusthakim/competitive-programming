class Solution {
public:
    int maxDistance(vector<int>& v) {
       int ans=0,sz=v.size();
       map<int,vector<int>>m;
       for(int i=0;i<sz;i++){
        m[v[i]].push_back(i);
       }
       for(int i=0;i<sz;i++){
         for(auto x : m){
            if(x.first!=v[i]){
                ans=max(ans,x.second.back()-i);
            }
         }
       }
       return ans;

    }
};
