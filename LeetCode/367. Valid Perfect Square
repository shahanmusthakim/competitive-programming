class Solution {
public:
    bool isPerfectSquare(int num) {
        int l=0,r=9673350,mid,ans;
        while(l<=r){
            mid=(l+r)/2;
            long long tmp=(long long)mid*mid;
            if(tmp==num)return true;
            else if(tmp<num)l=mid+1;
            else r=mid-1;
        }
        return false;
    }
};
