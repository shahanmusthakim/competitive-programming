class Solution {
public:
    int countElements(vector<int>& nums) {
        int n = nums.size();
        int mn = *min_element(nums.begin(), nums.end());
        int mx = *max_element(nums.begin(), nums.end());
        int ans = 0;
        for (int i = 0; i < n; i++) {
            if (nums[i] != mn && nums[i] != mx)
                ans++;
        }
        return ans;
    }
};
