class Solution {
public:
    string makeFancyString(string s) {
        string t = "";
        for (int i = 0; i < s.size(); i++) {
            if (i == 0 || i == s.size() - 1) {
                t.push_back(s[i]);
                continue;
            }
            if (s[i] != s[i - 1] || s[i] != s[i + 1]) {
                t.push_back(s[i]);
            }
        }
        return t;
    }
};
