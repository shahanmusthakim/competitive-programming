class Solution {
public:
    bool strongPasswordCheckerII(string password) {
        int n = password.size();
        if (n < 8)
            return false;
        int lower = 0, upper = 0, digit = 0, sp = 0;
        for (int i = 0; i < n; i++) {
            if (i != 0) {
                if (password[i] == password[i - 1])
                    return false;
            }
            if (password[i] >= 'a' && password[i] <= 'z')
                lower++;
            else if (password[i] >= 'A' && password[i] <= 'Z')
                upper++;
            else if (password[i] >= '0' && password[i] <= '9')
                digit++;
            else
                sp++;
        }
        return lower != 0 && upper != 0 && digit != 0 && sp != 0;
    }
};
